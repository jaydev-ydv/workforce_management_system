{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/employee/login", "destination": "/employee-login.html" },
    { "source": "/admin/:path*", "destination": "/dashboard.html" },
    { "source": "/admin", "destination": "/dashboard.html" },
    { "source": "/employee/:path*", "destination": "/employee-portal.html" },
    { "source": "/employee", "destination": "/employee-portal.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
