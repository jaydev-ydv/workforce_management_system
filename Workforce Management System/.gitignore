# ===================================================
# Workforce Management System - .gitignore
# ===================================================

# Environment Variables & Sensitive Credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
# Allow template/example environment file
!.env.example

# Node Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Deployment & Hosting
.vercel/

# Runtime Data, Logs & PIDs
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# Build & Distribution outputs
dist/
build/
out/
.cache/
.parcel-cache/

# Testing & Code Coverage
coverage/
.nyc_output/
*.lcov

# IDEs and Text Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# Operating System Files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Temporary & Cache files
*.tmp
*.temp
