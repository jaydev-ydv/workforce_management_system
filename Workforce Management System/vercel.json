{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin/login", "destination": "/frontend/admin-login.html" },
    { "source": "/employee/login", "destination": "/frontend/employee-login.html" },
    { "source": "/admin/:path*", "destination": "/frontend/dashboard.html" },
    { "source": "/admin", "destination": "/frontend/dashboard.html" },
    { "source": "/employee/:path*", "destination": "/frontend/employee-portal.html" },
    { "source": "/employee", "destination": "/frontend/employee-portal.html" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
